<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><NuGetAudit>true</NuGetAudit><NuGetAuditMode>all</NuGetAuditMode><NuGetAuditLevel>low</NuGetAuditLevel>
    <AssemblyName>hopo</AssemblyName><RootNamespace>Lantoss.Desktop</RootNamespace>
    <Version>2.1.1</Version><Product>hopo</Product><Title>hopo</Title><AssemblyTitle>hopo</AssemblyTitle><Description>hopo: local Wi-Fi file sharing and folder sync for macOS and Linux</Description>
    <!-- No ICU dependency on Linux; the UI formats dates and sizes explicitly. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/Lantoss.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup><AvaloniaResource Include="Assets/lantoss-256.png" /></ItemGroup>
</Project>
