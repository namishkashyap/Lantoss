<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="hopo" Width="1440" Height="960" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource Background}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
