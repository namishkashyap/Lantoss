  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Padding" Value="9,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="item" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource PrimarySoft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource PrimarySoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- Scrollbars use the same dynamic tokens as the page, including in dark mode. -->
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="11"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Border Background="{TemplateBinding Background}" Padding="2"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
     <Track.DecreaseRepeatButton><RepeatButton x:Name="decrease" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" CornerRadius="4" Opacity="0.45"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton x:Name="increase" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
    </Track></Border>
    <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="11"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,7,0,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="check" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Muted}" Background="{DynamicResource Surface}"><Path x:Name="tick" Data="M2,7 L6,11 L12,3" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="1" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="check" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="check" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="check" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="{DynamicResource GlassBorder}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="5"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Glass}"/><Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="22"/></Style>
 </Window.Resources>
 <Grid>
  <!-- hopo field: two soft glows and faint rings behind every page; glass cards let them show through. -->
  <Grid IsHitTestVisible="False" ClipToBounds="True"><Ellipse x:Name="GlowTop" Width="1500" Height="1150" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-560,-620,0,0" Fill="{DynamicResource GlowA}" Opacity="0.42"><Ellipse.OpacityMask><RadialGradientBrush><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#59000000" Offset="0.55"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.OpacityMask></Ellipse><Ellipse x:Name="GlowBottom" Width="1500" Height="1150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-560,-620" Fill="{DynamicResource GlowB}" Opacity="0.3"><Ellipse.OpacityMask><RadialGradientBrush><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#59000000" Offset="0.55"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.OpacityMask></Ellipse><Grid Width="1800" Height="1800" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-900,-900,0"><Grid.OpacityMask><RadialGradientBrush><GradientStop Color="#FF000000" Offset="0.2"/><GradientStop Color="#00000000" Offset="0.65"/></RadialGradientBrush></Grid.OpacityMask><Ellipse Width="256" Height="256" Stroke="{DynamicResource Ring}" StrokeThickness="1"/><Ellipse Width="384" Height="384" Stroke="{DynamicResource Ring}" StrokeThickness="1"/><Ellipse Width="512" Height="512" Stroke="{DynamicResource Ring}" StrokeThickness="1"/><Ellipse Width="640" Height="640" Stroke="{DynamicResource Ring}" StrokeThickness="1"/><Ellipse Width="768" Height="768" Stroke="{DynamicResource Ring}" StrokeThickness="1"/><Ellipse Width="896" Height="896" Stroke="{DynamicResource Ring}" StrokeThickness="1"/><Ellipse Width="1024" Height="1024" Stroke="{DynamicResource Ring}" StrokeThickness="1"/><Ellipse Width="1152" Height="1152" Stroke="{DynamicResource Ring}" StrokeThickness="1"/></Grid></Grid>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,0,0,1" Padding="32,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="HomeLink" Style="{StaticResource Plain}" Padding="4,6" AutomationProperties.Name="hopo home" ToolTip="Home"><StackPanel Orientation="Horizontal"><Canvas Width="26" Height="26" Margin="0,0,10,0"><Ellipse Canvas.Left="9.5" Canvas.Top="9.5" Width="7" Height="7" Fill="{DynamicResource Accent}"/><Ellipse Canvas.Left="5.5" Canvas.Top="5.5" Width="15" Height="15" Stroke="{DynamicResource Text}" StrokeThickness="1.2" Opacity="0.45"/><Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="23" Height="23" Stroke="{DynamicResource Text}" StrokeThickness="1.2" Opacity="0.25"/><Ellipse Canvas.Left="18.7" Canvas.Top="6.2" Width="3.6" Height="3.6" Fill="{DynamicResource Mint}"/></Canvas><TextBlock Text="hopo" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Text="/" Foreground="{DynamicResource Muted}" FontSize="14" Margin="12,0" VerticalAlignment="Center"/><TextBlock x:Name="PageTitle" Text="Home" FontSize="14" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" VerticalAlignment="Center"/><Border CornerRadius="999" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1"><TextBlock x:Name="ModeBadge" Text="LOCAL" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/></Border></StackPanel><Grid x:Name="SearchArea" Grid.Column="1" Width="220" VerticalAlignment="Center" Margin="0,0,10,0"><TextBox x:Name="SearchBox" Height="44" ToolTip="Search the current view" AutomationProperties.Name="Search the current view"/><TextBlock Text="Search this view…" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Border Grid.Column="2" CornerRadius="999" Height="34" Padding="12,0" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="NetworkDot" Width="7" Height="7" Fill="{DynamicResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="NetworkStatus" Text="Receiving off" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="NoWrap"/></StackPanel></Border><Button x:Name="ReceiveToggle" Grid.Column="3" Content="Start receiving" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="MenuButton" Grid.Column="4" Width="44" Height="44" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Open menu" ToolTip="Menu"><Path Data="M4,7 L20,7 M4,12 L20,12 M4,17 L14,17" Stroke="{DynamicResource Text}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" HorizontalAlignment="Center"/></Button></Grid></Border>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="PageContent" Margin="32,40,32,40" MaxWidth="1120" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"/></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,0" Padding="32,9"><TextBlock x:Name="Feedback" Text="Ready to share on your local network." Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Border>
  </Grid>
  <!-- Slide-out menu: Share and Manage groups, this PC, storage and appearance. -->
  <Grid x:Name="MenuLayer" Visibility="Collapsed">
   <Button x:Name="MenuScrim" Focusable="False" AutomationProperties.Name="Close menu" Cursor="Arrow"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{DynamicResource Scrim}"/></ControlTemplate></Button.Template></Button>
   <Border x:Name="MenuPanel" Width="380" HorizontalAlignment="Right" Margin="0,8,18,24" CornerRadius="24" Padding="14" Background="{DynamicResource Menu}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="18" Opacity="0.45" Color="#000000"/></Border.Effect>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><DockPanel MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
     <DockPanel DockPanel.Dock="Top" Margin="10,2,2,10"><Button x:Name="CloseMenu" DockPanel.Dock="Right" Width="44" Height="44" Padding="0" AutomationProperties.Name="Close menu" ToolTip="Close"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource Text}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" HorizontalAlignment="Center"/></Button><TextBlock Text="Menu" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Border Padding="12" CornerRadius="14" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1"><DockPanel><ContentControl x:Name="ThisAvatar" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" Focusable="False"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ThisDevice" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="This Windows PC" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></DockPanel></Border><DockPanel Margin="4,14,4,8"><TextBlock x:Name="StorageText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock Text="Local storage" FontSize="12" Foreground="{DynamicResource Muted}"/></DockPanel><ProgressBar x:Name="StorageBar" Maximum="100" Height="4" Margin="4,0,4,14"/><DockPanel Margin="4,0,4,4"><ComboBox x:Name="AppearanceSelector" DockPanel.Dock="Right" Width="130" AutomationProperties.Name="Appearance" ToolTip="Choose System, Light, or Dark"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Appearance" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="AppearanceStatus" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></DockPanel><Button x:Name="OpenBrowser" Content="Open the phone page here" HorizontalAlignment="Stretch" Margin="4,10,4,10"/><TextBlock Text="No account. No cloud. · hopo 2.0" FontSize="12" Foreground="{DynamicResource Muted}" Margin="4,0,0,0"/></StackPanel>
     <StackPanel x:Name="Navigation" DockPanel.Dock="Top"/>
    </DockPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>
