<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Per-user MSI plus a signed sparse package for the native Windows 11 command. -->
  <Package Name="Lantoss" Manufacturer="Lantoss" Version="2.0.0" Language="1033" Scope="perUser" UpgradeCode="C9C1C9EF-9399-4CAB-A89E-D84BE5C41067" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer Lantoss version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="LantossIcon" SourceFile="$(var.ReleaseDir)\source\UI\Lantoss.ico" />
    <Property Id="ARPPRODUCTICON" Value="LantossIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/namishkashyap/Lantoss" />
    <Property Id="ARPNOMODIFY" Value="0" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Lantoss" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Lantoss">
          <Component Id="Application" Guid="20A4372C-84B0-4264-AB42-70866890481A">
            <File Id="LantossExe" Source="$(var.ReleaseDir)\app\Lantoss.exe" />
            <RegistryValue Root="HKCU" Key="Software\Lantoss\Installation" Name="Path" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
            <!-- The app may create/remove these entries later through Settings. Uninstall owns cleanup. -->
            <RemoveRegistryKey Root="HKCU" Key="Software\Lantoss\Desktop" Action="removeOnUninstall" />
            <RemoveRegistryKey Root="HKCU" Key="Software\Lantoss\Installation" Action="removeOnUninstall" />
          </Component>
          <Component Id="ModernExplorerFiles" Guid="90DC53A7-0BA0-4BE8-995E-ACB730AC84E3">
            <RegistryValue Root="HKCU" Key="Software\Lantoss\Installation" Name="ModernExplorer" Value="1" Type="integer" KeyPath="yes" />
            <File Id="ExplorerDll" Source="$(var.ReleaseDir)\app\LantossExplorer.dll" />
            <File Id="ExplorerMsix" Source="$(var.ReleaseDir)\app\Lantoss.Explorer.msix" />
            <File Id="RegisterPackageScript" Source="$(var.ReleaseDir)\app\RegisterPackage.ps1" />
          </Component>
          <Directory Id="AssetsFolder" Name="Assets"><Component Id="ExplorerAssets" Guid="DE2D9075-D66C-40C3-856C-17004200FE19">
            <RegistryValue Root="HKCU" Key="Software\Lantoss\Installation" Name="ExplorerAssets" Value="1" Type="integer" KeyPath="yes" />
            <File Source="$(var.ReleaseDir)\app\Assets\Logo.png" /><File Source="$(var.ReleaseDir)\app\Assets\SmallLogo.png" />
            <RemoveFolder Id="RemoveExplorerAssets" On="uninstall" />
          </Component></Directory>
          <Directory Id="DocumentsFolder" Name="Documentation">
            <Component Id="Documents" Guid="FE36FDA2-3E97-47B0-A422-C1AE72C8F420">
              <RegistryValue Root="HKCU" Key="Software\Lantoss\Installation" Name="Documentation" Value="1" Type="integer" KeyPath="yes" />
              <File Source="$(var.ReleaseDir)\README.md" />
              <File Source="$(var.ReleaseDir)\SETUP.md" />
              <File Source="$(var.ReleaseDir)\DEVELOPER_GUIDE.md" />
              <File Source="$(var.ReleaseDir)\DOTNET_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\DOTNET_THIRD_PARTY_NOTICES.txt" />
              <File Source="$(var.ReleaseDir)\ASPNET_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\ASPNET_THIRD-PARTY-NOTICES.TXT" />
              <File Source="$(var.ReleaseDir)\BOUNCY_CASTLE_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\QRCODER_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\WIX_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\MINGW_RUNTIME_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\GCC_GPL3_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\GCC_RUNTIME_EXCEPTION.txt" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="LantossMenu" Name="Lantoss">
        <Component Id="StartMenu" Guid="A011CD1B-FF04-4D11-A596-BE6A2B5FA9FA">
          <Shortcut Id="StartLantoss" Name="Lantoss" Target="[#LantossExe]" WorkingDirectory="INSTALLFOLDER" Icon="LantossIcon" />
          <Shortcut Id="StartLantossServer" Name="Lantoss in the tray" Target="[#LantossExe]" Arguments="--background" WorkingDirectory="INSTALLFOLDER" Icon="LantossIcon" />
          <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Lantoss\Installation" Name="StartMenu" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="071DB026-15EB-4CB9-85C9-AB57E552ED20">
        <Shortcut Id="DesktopLantoss" Name="Lantoss" Target="[#LantossExe]" WorkingDirectory="INSTALLFOLDER" Icon="LantossIcon" />
        <RegistryValue Root="HKCU" Key="Software\Lantoss\Installation" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="SignInStartup" Guid="0F5E83A3-638E-4BC1-919D-B304E378420B">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Lantoss" Value="&quot;[#LantossExe]&quot; --background" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="ExplorerSharing" Guid="B83E5C0A-C82D-44CC-8508-990CD5326ABD">
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\*\shell\Lantoss" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Lantoss" Action="removeOnUninstall" />
        <RegistryValue Root="HKCU" Key="Software\Lantoss\Desktop" Name="ExplorerEnabled" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="Core" Title="Lantoss application" Description="File transfer, shared folders, sync and the local browser server. Required." Level="1" AllowAbsent="no" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="Application" /><ComponentRef Id="Documents" /><ComponentRef Id="StartMenu" />
    </Feature>
    <Feature Id="Explorer" Title="Share with Lantoss in Explorer" Description="Windows 11 main menu: share with a remembered PC. This development build asks once for publisher trust and Windows administrator approval." Level="1"><ComponentRef Id="ExplorerSharing" /><ComponentRef Id="ModernExplorerFiles" /><ComponentRef Id="ExplorerAssets" /></Feature>
    <Feature Id="Desktop" Title="Desktop shortcut" Description="Add a Lantoss shortcut to your desktop." Level="2"><ComponentRef Id="DesktopShortcut" /></Feature>
    <Feature Id="Startup" Title="Launch Lantoss at sign-in" Description="Launch Lantoss in the tray when this Windows account signs in. Automatic server startup is enabled by default in the app." Level="2"><ComponentRef Id="SignInStartup" /></Feature>
    <ui:WixUI Id="WixUI_FeatureTree" />
    <UI>
      <!-- No app license is invented: go directly from Welcome to optional features. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="5" Condition="NOT Installed" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="5" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLantoss" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <CustomAction Id="LaunchLantoss" FileRef="LantossExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
    <CustomAction Id="RemoveUserIntegration" FileRef="LantossExe" ExeCommand="--uninstall-integration" Return="check" Impersonate="yes" />
    <CustomAction Id="RegisterExplorerPackage" FileRef="LantossExe" ExeCommand="--install-integration" Execute="deferred" Return="check" Impersonate="yes" />
    <CustomAction Id="RollbackExplorerPackage" FileRef="LantossExe" ExeCommand="--remove-explorer-package" Execute="rollback" Return="ignore" Impersonate="yes" />
    <CustomAction Id="RemoveExplorerPackage" FileRef="LantossExe" ExeCommand="--remove-explorer-package" Return="check" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="RemoveExplorerPackage" Before="RemoveFiles" Condition="&amp;Explorer = 2 AND !Explorer = 3 AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackExplorerPackage" After="InstallFiles" Condition="&amp;Explorer = 3 AND NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="RegisterExplorerPackage" After="RollbackExplorerPackage" Condition="&amp;Explorer = 3" /><Custom Action="RemoveUserIntegration" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" /></InstallExecuteSequence>
  </Package>
</Wix>
