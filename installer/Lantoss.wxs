<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- One per-user MSI per app: -d App=Users builds hopo Users (hopoUsers.exe), -d App=Admin builds hopo Admin (hopoAdmin.exe). -->
  <?if $(var.App) = "Admin" ?>
  <?define AppName = "hopo Admin" ?><?define AppExe = "hopoAdmin.exe" ?><?define AppFolder = "hopo Admin" ?><?define AppUpgrade = "5B7E2C91-4D3A-4F8E-A1C6-7D9E0B2F3A84" ?>
  <?define AppKey = "Software\Lantoss\AdminInstallation" ?><?define RunName = "hopo Admin" ?>
  <?define GuidApp = "8C4F1E2A-6B3D-4A7C-9E5F-1D2B3C4A5E60" ?><?define GuidRegister = "3E9A7C1B-5D2F-4B8E-A6C4-2F1E0D9B8A71" ?><?define GuidDocs = "B2D4F6A8-1C3E-4D5F-8A9B-7C6D5E4F3A21" ?>
  <?define GuidMenu = "E1F2A3B4-C5D6-4E7F-8A9B-0C1D2E3F4A52" ?><?define GuidDesktop = "F6E5D4C3-B2A1-4F0E-9D8C-7B6A5F4E3D13" ?><?define GuidRun = "A9B8C7D6-E5F4-4A3B-8C2D-1E0F9A8B7C64" ?><?define GuidShell = "C3D2E1F0-A9B8-4C7D-9E6F-5A4B3C2D1E05" ?>
  <?else ?>
  <?define AppName = "hopo Users" ?><?define AppExe = "hopoUsers.exe" ?><?define AppFolder = "hopo" ?><?define AppUpgrade = "C9C1C9EF-9399-4CAB-A89E-D84BE5C41067" ?>
  <?define AppKey = "Software\Lantoss\Installation" ?><?define RunName = "Lantoss" ?>
  <?define GuidApp = "20A4372C-84B0-4264-AB42-70866890481A" ?><?define GuidRegister = "90DC53A7-0BA0-4BE8-995E-ACB730AC84E3" ?><?define GuidDocs = "FE36FDA2-3E97-47B0-A422-C1AE72C8F420" ?>
  <?define GuidMenu = "A011CD1B-FF04-4D11-A596-BE6A2B5FA9FA" ?><?define GuidDesktop = "071DB026-15EB-4CB9-85C9-AB57E552ED20" ?><?define GuidRun = "0F5E83A3-638E-4BC1-919D-B304E378420B" ?><?define GuidShell = "B83E5C0A-C82D-44CC-8508-990CD5326ABD" ?>
  <?endif ?>
  <Package Name="$(var.AppName)" Manufacturer="hopo" Version="2.5.3" Language="1033" Scope="perUser" UpgradeCode="$(var.AppUpgrade)" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer $(var.AppName) version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="LantossIcon" SourceFile="$(var.ReleaseDir)\source\UI\Lantoss.ico" />
    <Property Id="ARPPRODUCTICON" Value="LantossIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/namishkashyap/Lantoss" />
    <Property Id="ARPNOMODIFY" Value="0" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open $(var.AppName)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(var.AppFolder)">
          <Component Id="Application" Guid="$(var.GuidApp)">
            <File Id="AppExe" Source="$(var.ReleaseDir)\app\$(var.AppExe)" />
            <RegistryValue Root="HKCU" Key="$(var.AppKey)" Name="Path" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
            <!-- The app may create/remove these entries later through Settings. Uninstall owns cleanup. -->
            <RemoveRegistryKey Root="HKCU" Key="Software\Lantoss\Desktop" Action="removeOnUninstall" />
            <RemoveRegistryKey Root="HKCU" Key="$(var.AppKey)" Action="removeOnUninstall" />
          </Component>
          <!-- Only removes the Windows 11 menu package that hopo 2.3 and earlier registered; 2.4 uses the classic right-click entry. -->
          <Component Id="PackageCleanup" Guid="$(var.GuidRegister)">
            <RegistryValue Root="HKCU" Key="$(var.AppKey)" Name="PackageCleanup" Value="1" Type="integer" KeyPath="yes" />
            <File Id="RegisterPackageScript" Source="$(var.ReleaseDir)\app\RegisterPackage.ps1" />
          </Component>
          <Directory Id="DocumentsFolder" Name="Documentation">
            <Component Id="Documents" Guid="$(var.GuidDocs)">
              <RegistryValue Root="HKCU" Key="$(var.AppKey)" Name="Documentation" Value="1" Type="integer" KeyPath="yes" />
              <File Source="$(var.ReleaseDir)\README.md" />
              <File Source="$(var.ReleaseDir)\SETUP.md" />
              <File Source="$(var.ReleaseDir)\DEVELOPER_GUIDE.md" />
              <File Source="$(var.ReleaseDir)\DOTNET_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\DOTNET_THIRD_PARTY_NOTICES.txt" />
              <File Source="$(var.ReleaseDir)\ASPNET_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\ASPNET_THIRD-PARTY-NOTICES.TXT" />
              <File Source="$(var.ReleaseDir)\BOUNCY_CASTLE_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\QRCODER_LICENSE.txt" />
              <File Source="$(var.ReleaseDir)\WIX_LICENSE.txt" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="LantossMenu" Name="$(var.AppFolder)">
        <Component Id="StartMenu" Guid="$(var.GuidMenu)">
          <Shortcut Id="StartApp" Name="$(var.AppName)" Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" Icon="LantossIcon" />
          <Shortcut Id="StartAppServer" Name="$(var.AppName) in the tray" Target="[#AppExe]" Arguments="--background" WorkingDirectory="INSTALLFOLDER" Icon="LantossIcon" />
          <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="$(var.AppKey)" Name="StartMenu" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="$(var.GuidDesktop)">
        <Shortcut Id="DesktopApp" Name="$(var.AppName)" Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" Icon="LantossIcon" />
        <RegistryValue Root="HKCU" Key="$(var.AppKey)" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="SignInStartup" Guid="$(var.GuidRun)">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="$(var.RunName)" Value="&quot;[#AppExe]&quot; --background" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="ExplorerSharing" Guid="$(var.GuidShell)">
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\*\shell\Lantoss" Action="removeOnUninstall" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Lantoss" Action="removeOnUninstall" />
        <RegistryValue Root="HKCU" Key="Software\Lantoss\Desktop" Name="ExplorerEnabled" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="Core" Title="$(var.AppName)" Description="File transfer, shared folders, sync and the local browser server. Required." Level="1" AllowAbsent="no" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="Application" /><ComponentRef Id="PackageCleanup" /><ComponentRef Id="Documents" /><ComponentRef Id="StartMenu" />
    </Feature>
    <Feature Id="Explorer" Title="Share in Explorer" Description="Adds Share with hopo to the right-click menu (on Windows 11, under Show more options)." Level="1"><ComponentRef Id="ExplorerSharing" /></Feature>
    <Feature Id="Desktop" Title="Desktop shortcut" Description="Add a $(var.AppName) shortcut to your desktop." Level="2"><ComponentRef Id="DesktopShortcut" /></Feature>
    <Feature Id="Startup" Title="Launch at sign-in" Description="Launch $(var.AppName) in the tray when this Windows account signs in. Automatic server startup is enabled by default in the app." Level="2"><ComponentRef Id="SignInStartup" /></Feature>
    <ui:WixUI Id="WixUI_FeatureTree" />
    <UI>
      <!-- No app license is invented: go directly from Welcome to optional features. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="5" Condition="NOT Installed" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="5" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <CustomAction Id="LaunchApp" FileRef="AppExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
    <CustomAction Id="RemoveUserIntegration" FileRef="AppExe" ExeCommand="--uninstall-integration" Return="check" Impersonate="yes" />
    <!-- Earlier versions keep their Windows 11 package registered across upgrades; remove it once the new app is in place. -->
    <CustomAction Id="RemoveOldExplorerPackage" FileRef="AppExe" ExeCommand="--remove-explorer-package" Execute="deferred" Return="ignore" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="RemoveOldExplorerPackage" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RemoveUserIntegration" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
